{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 300
      }
    }
  ],
  "routes": [
    {
      "src": "/public/(.*)",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/monthly-credits",
      "schedule": "0 6 1 * *"
    },
    {
      "path": "/api/rebuild-leaderboard-cron",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cleanup-unverified",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cleanup-audio",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/check-team-expiry",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/monthly-emails",
      "schedule": "0 8 1 * *"
    },
    {
      "path": "/api/developer/monthly-reset",
      "schedule": "0 7 1 * *"
    },
    {
      "path": "/api/developer/renewal-reminder",
      "schedule": "0 9 * * *"
    }
  ]
}






